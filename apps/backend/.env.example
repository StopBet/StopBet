PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/stopbet
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_change_in_production
GEMINI_API_KEY=your_gemini_api_key

# Clave de 32 bytes en hex para cifrar el RUT en reposo (AES-256-GCM). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# pnpm run seed crea 9 usuarios de prueba (patient/sponsor/psychologist/coordinator)
# con la misma clave de desarrollo: Stopbet2026!

# Firebase (CA7.4 — notificaciones push).
# En local: ruta al service account descargado de la consola de Firebase.
# En Railway: pegar el JSON completo en FIREBASE_SERVICE_ACCOUNT_JSON, porque
# ahi no se pueden subir archivos. Sin ninguna de las dos, el backend arranca
# igual y solo se desactivan los push.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
