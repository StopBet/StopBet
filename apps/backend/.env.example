PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/stopbet
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_change_in_production
GEMINI_API_KEY=your_gemini_api_key

# Clave de 32 bytes en hex para cifrar el RUT en reposo (AES-256-GCM). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# pnpm run seed crea 9 usuarios de prueba (patient/sponsor/psychologist/coordinator)
# con la misma clave de desarrollo: Stopbet2026!

# Firebase (CA7.4 — notificaciones push).
# En local: ruta al service account descargado de la consola de Firebase.
# En Railway: pegar el JSON completo en FIREBASE_SERVICE_ACCOUNT_JSON, porque
# ahi no se pueden subir archivos. Sin ninguna de las dos, el backend arranca
# igual y solo se desactivan los push.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# SMTP (CA24.1 — envío de credenciales al crear un psicólogo).
# Sin SMTP_HOST el backend arranca igual, no manda ningún correo y el coordinador
# sigue entregando la contraseña a mano desde la pantalla de Equipo.
# Sirve cualquier proveedor: Resend, Brevo, SendGrid, o un buzón falso local.
#
# Buzón falso para probar sin cuenta de nada (no manda nada a internet):
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost / SMTP_PORT=1025 / sin usuario ni clave
#   y los correos se leen en http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Debe ser una dirección de un dominio verificado en el proveedor, o cae en spam.
MAIL_FROM=StopBet <no-reply@ejemplo.cl>
# Base de los enlaces dentro de los correos
WEB_APP_URL=http://localhost:5173
